# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in your values:   cp .env.example .env.local
# .env.local is gitignored — real values never get committed.
# ─────────────────────────────────────────────────────────────────────────────

# Hugging Face access token with WRITE permission on the target org
# (your Hugging Face namespace) — used only by the final `publish` node to upload the
# fused model. Create one at https://huggingface.co/settings/tokens and make
# sure its fine-grained scope includes the target namespace.
HF_TOKEN=

# Optional: a personal token for your own private repos, if you need to pull
# private base models/datasets that live under your personal account.
HF_TOKEN_PERSONAL=

# Host port for the MLflow UI/API. Keep 5001 unless it clashes with something
# on your machine (macOS AirPlay already occupies 5000, so don't use that).
MLFLOW_HOST_PORT=5001

# Host port for the ZenML dashboard/API.
ZENML_HOST_PORT=8080

# Where the pipeline sends metrics/artifacts. Must match MLFLOW_HOST_PORT above.
MLFLOW_TRACKING_URI=http://localhost:5001

# Where the ZenML client connects (`zenml login $ZENML_SERVER_URL`).
# Must match ZENML_HOST_PORT above.
ZENML_SERVER_URL=http://localhost:8080
